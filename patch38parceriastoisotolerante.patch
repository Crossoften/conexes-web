+    } else if (raw.length === 8) {                          // ddmmaaaa
+      d = +raw.slice(0, 2); mo = +raw.slice(2, 4); y = +raw.slice(4);
+    } else {
+      return undefined;
+    }
+
+    const date = new Date(Date.UTC(y, mo - 1, d));
