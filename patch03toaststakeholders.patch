 .pagination { display: flex; align-items: center; justify-content: space-between; padding: 14px 24px; border-top: 1px solid var(--surface-border, #E5E7EB); background: #FAFAFE; }
 .pagination__nav { display: flex; align-items: center; gap: 4px; }
 .pag-btn { min-width: 34px; height: 34px; padding: 0 8px; border-radius: var(--radius-sm, 6px); border: 1.5px solid var(--surface-border-mid, #E5E7EB); background: var(--surface-primary, #ffffff); color: var(--text-secondary); font-size: 13px; font-weight: 500; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all var(--transition); &:hover:not(:disabled):not(.pag-btn--active) { border-color: var(--brand-purple-mid); color: var(--brand-purple); background: var(--brand-purple-light); } &--active { background: var(--brand-purple); border-color: var(--brand-purple); color: #fff; pointer-events: none; } &:disabled { opacity: .4; cursor: not-allowed; } }
+
+// ── Toast de feedback ─────────────────────────
+.toast {
+  position: fixed;
+  bottom: 24px;
+  right: 24px;
+  z-index: 1000;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  max-width: 380px;
+  padding: 14px 18px;
+  border-radius: var(--radius-md, 10px);
+  background: var(--surface-primary, #ffffff);
+  border: 1px solid var(--surface-border-mid, #E5E7EB);
+  border-left: 4px solid var(--text-muted, #9CA3AF);
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
+  font-size: 13.5px;
+  font-weight: 500;
+  color: var(--text-primary, #1F2937);
+  animation: toast-in 0.25s ease-out;
+
+  svg { flex-shrink: 0; }
+
+  &--success {
+    border-left-color: #16A34A;
+    svg { color: #16A34A; }
+  }
+
+  &--error {
+    border-left-color: #DC2626;
+    svg { color: #DC2626; }
+  }
+}
+
+@keyframes toast-in {
+  from { opacity: 0; transform: translateY(12px); }
+  to   { opacity: 1; transform: translateY(0); }
+}
 .pag-ellipsis { display: flex; align-items: center; justify-content: center; min-width: 34px; height: 34px; color: var(--text-muted); font-size: 13px; }
